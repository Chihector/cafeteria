APP_NAME="Café Rosé"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cafeteria.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL/MariaDB de producción (no SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cafeteria
DB_USERNAME=cafeteria
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# Sesiones y caché en base de datos, no en archivos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Tiempo real con Reverb detrás de Nginx + TLS
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CAMBIAR_ID
REVERB_APP_KEY=CAMBIAR_KEY
REVERB_APP_SECRET=CAMBIAR_SECRET
REVERB_HOST=ws.cafeteria.example.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@cafeteria.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Impresora térmica de red (misma LAN que el servidor)
PRINTER_ENABLED=false
PRINTER_AUTO_PRINT=true
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_TIMEOUT=3
PRINTER_WIDTH=42
